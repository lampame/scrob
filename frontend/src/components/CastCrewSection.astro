---
interface Person {
  tmdb_id?: number | null;
  person_id?: number | null;
  name: string;
  character?: string | null;
  job?: string | null;
  profile_path?: string | null;
}

interface Props {
  cast?: Person[];
  crew?: Person[];
}

const { cast = [], crew = [] } = Astro.props;
const hasCast = cast.length > 0;
const hasCrew = crew.length > 0;

function personHref(person: Person): string | null {
  if (person.tmdb_id) return `/person/${person.tmdb_id}`;
  if (person.person_id) return `https://www.thetvdb.com/people/${person.person_id}`;
  return null;
}
function isExternal(person: Person): boolean {
  return !person.tmdb_id && !!person.person_id;
}
---

{hasCast && (
<div class="mt-24 border-zinc-900 pt-16" data-castcrew>
  <div class="flex items-center gap-2 mb-10">
    <button type="button" class="castcrew-tab-btn px-5 py-3 text-sm font-black uppercase tracking-wide text-zinc-100 border-b-2 border-blue-500 transition-colors cursor-pointer" data-tab="cast">
      Cast
    </button>
    {hasCrew && (
      <button type="button" class="castcrew-tab-btn px-5 py-3 text-sm font-black uppercase tracking-wide text-zinc-500 hover:text-zinc-300 border-b-2 border-transparent transition-colors cursor-pointer" data-tab="crew">
        Crew
      </button>
    )}
  </div>

  <div class="castcrew-panel grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-6 gap-6" data-panel="cast">
    {cast.map((person) => {
      const href = personHref(person);
      const external = isExternal(person);
      const inner = (
        <>
          <div class="aspect-square w-full rounded-2xl overflow-hidden mb-5 ring-2 ring-zinc-800/50 group-hover/cast:ring-blue-500 transition-all duration-500 shadow-lg">
            {person.profile_path ? (
              <img src={person.profile_path} alt={person.name} class="w-full h-full object-cover group-hover/cast:scale-110 transition-transform duration-700" loading="lazy" decoding="async" />
            ) : (
              <div class="w-full h-full bg-zinc-800 flex items-center justify-center text-zinc-600"><svg xmlns="http://www.w3.org/2000/svg" width="40%" height="40%" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg></div>
            )}
          </div>
          <div class="space-y-1.5 text-center">
            <p class="text-sm font-black text-zinc-100 group-hover/cast:text-blue-400 transition-colors line-clamp-1 leading-tight">{person.name}</p>
            <p class="text-[11px] text-zinc-500 font-bold uppercase tracking-wider line-clamp-1 opacity-80">{person.character}</p>
          </div>
        </>
      );
      return href ? (
        <a href={href} target={external ? "_blank" : undefined} rel={external ? "noopener noreferrer" : undefined} class="group/cast bg-zinc-900/20 border border-zinc-800/40 p-4 rounded-3xl hover:bg-zinc-800/40 hover:border-blue-500/50 transition-all duration-500 hover:shadow-2xl hover:shadow-blue-900/10 active:scale-95 active:opacity-70">
          {inner}
        </a>
      ) : (
        <div class="group/cast bg-zinc-900/20 border border-zinc-800/40 p-4 rounded-3xl">
          {inner}
        </div>
      );
    })}
  </div>

  {hasCrew && (
    <div class="castcrew-panel hidden grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-6 gap-6" data-panel="crew">
      {crew.map((person) => {
        const href = personHref(person);
        const external = isExternal(person);
        const inner = (
          <>
            <div class="aspect-square w-full rounded-2xl overflow-hidden mb-5 ring-2 ring-zinc-800/50 group-hover/cast:ring-blue-500 transition-all duration-500 shadow-lg">
              {person.profile_path ? (
                <img src={person.profile_path} alt={person.name} class="w-full h-full object-cover group-hover/cast:scale-110 transition-transform duration-700" loading="lazy" decoding="async" />
              ) : (
                <div class="w-full h-full bg-zinc-800 flex items-center justify-center text-zinc-600"><svg xmlns="http://www.w3.org/2000/svg" width="40%" height="40%" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg></div>
              )}
            </div>
            <div class="space-y-1.5 text-center">
              <p class="text-sm font-black text-zinc-100 group-hover/cast:text-blue-400 transition-colors line-clamp-1 leading-tight">{person.name}</p>
              <p class="text-[11px] text-zinc-500 font-bold uppercase tracking-wider line-clamp-1 opacity-80">{person.job}</p>
            </div>
          </>
        );
        return href ? (
          <a href={href} target={external ? "_blank" : undefined} rel={external ? "noopener noreferrer" : undefined} class="group/cast bg-zinc-900/20 border border-zinc-800/40 p-4 rounded-3xl hover:bg-zinc-800/40 hover:border-blue-500/50 transition-all duration-500 hover:shadow-2xl hover:shadow-blue-900/10 active:scale-95 active:opacity-70">
            {inner}
          </a>
        ) : (
          <div class="group/cast bg-zinc-900/20 border border-zinc-800/40 p-4 rounded-3xl">
            {inner}
          </div>
        );
      })}
    </div>
  )}
</div>
)}

<script>
  document.querySelectorAll('[data-castcrew]').forEach((container) => {
    const buttons = container.querySelectorAll<HTMLButtonElement>('.castcrew-tab-btn');
    const panels = container.querySelectorAll<HTMLElement>('.castcrew-panel');
    buttons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const target = btn.dataset.tab;
        buttons.forEach((b) => {
          const active = b === btn;
          b.classList.toggle('border-blue-500', active);
          b.classList.toggle('text-zinc-100', active);
          b.classList.toggle('border-transparent', !active);
          b.classList.toggle('text-zinc-500', !active);
        });
        panels.forEach((p) => {
          p.classList.toggle('hidden', p.dataset.panel !== target);
        });
      });
    });
  });
</script>
