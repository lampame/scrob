---
// Decorative full-viewport poster-wall background, shared by /login and /link.
// Pulls a cached snapshot of trending posters (public endpoint); falls back to
// gradient tiles when the instance has no TMDB key yet. Sits behind page
// content at z-0 with a theme-aware wash over it for legibility.
import { api } from "../lib/api";

const pwIcon = (paths: string): string =>
  `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">${paths}</svg>`;

const fallbackIcon = pwIcon('<rect width="20" height="20" x="2" y="2" rx="2.18" ry="2.18"/><line x1="7" x2="7" y1="2" y2="22"/><line x1="17" x2="17" y1="2" y2="22"/><line x1="2" x2="22" y1="7" y2="7"/><line x1="2" x2="22" y1="12" y2="12"/><line x1="2" x2="22" y1="17" y2="17"/>');

const { posters } = await api.media.publicPosterWall().catch(() => ({ posters: [] }));

const PW_COLS = 7;
const PW_ROWS = 4;
const pwDepths = [0.4, 1, 0.65, 1.2, 0.5, 0.9, 0.7]; // per-column parallax intensity
const pwColumns: { poster: (typeof posters)[number] | null; depth: number }[][] = Array.from(
  { length: PW_COLS },
  (_, ci) =>
    Array.from({ length: PW_ROWS }, (_, ri) => {
      const idx = ci * PW_ROWS + ri;
      return {
        poster: posters.length ? posters[idx % posters.length] : null,
        depth: pwDepths[ci % pwDepths.length],
      };
    })
);
---

<div id="poster-wall-viewport" class="fixed inset-0 z-0 overflow-hidden pointer-events-none" aria-hidden="true">
  <div class="poster-wall">
    {pwColumns.map((col, ci) => (
      <div class={`pw-col pw-drift-${ci % 3}`} data-depth={col[0]?.depth ?? 0.7}>
        {col.map(({ poster }, ri) => (
          poster ? (
            <div class="pw-card pw-card--poster">
              <img
                src={`https://image.tmdb.org/t/p/w342${poster.poster_path}`}
                alt=""
                loading="lazy"
                referrerpolicy="no-referrer"
              />
            </div>
          ) : (
            <div class={`pw-card pw-g${(ri * 3 + ci) % 5}`}>
              <span class="pw-icon" set:html={fallbackIcon} />
            </div>
          )
        ))}
      </div>
    ))}
  </div>
  <div class="pw-overlay"></div>
</div>

<style is:global>
  /* ── Poster-wall background ── */
  .poster-wall {
    position: absolute;
    inset: -10%;
    display: flex;
    justify-content: center;
    gap: clamp(1.5rem, 2.6vw, 3rem);
    transform: rotate(-4deg);
  }
  .pw-col {
    display: flex;
    flex-direction: column;
    gap: clamp(1.5rem, 2.6vw, 3rem);
    flex: 0 0 auto;
    width: clamp(140px, 13vw, 210px);
    transition: transform 0.7s cubic-bezier(0.16, 1, 0.3, 1);
    will-change: transform;
  }
  .pw-col:nth-child(even) { margin-top: -6rem; }
  .pw-card {
    aspect-ratio: 2 / 3;
    border-radius: 0.75rem;
    border: 1px solid rgba(255, 255, 255, 0.06);
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .pw-icon { width: 34%; color: rgba(255, 255, 255, 0.16); }
  .pw-icon svg { width: 100%; height: auto; }

  .pw-card--poster {
    overflow: hidden;
    background: #111;
    box-shadow: 0 14px 34px -14px rgba(0, 0, 0, 0.65);
  }
  .pw-card--poster img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    filter: saturate(1.02) brightness(0.98);
  }

  .pw-g0 { background: linear-gradient(160deg, #312e81, #1e1b4b); }
  .pw-g1 { background: linear-gradient(160deg, #581c87, #3b0764); }
  .pw-g2 { background: linear-gradient(160deg, #881337, #4c0519); }
  .pw-g3 { background: linear-gradient(160deg, #115e59, #042f2e); }
  .pw-g4 { background: linear-gradient(160deg, #075985, #082f49); }

  .pw-overlay {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(
        115deg,
        color-mix(in srgb, var(--color-bg-page) 62%, transparent) 0%,
        color-mix(in srgb, var(--color-bg-page) 34%, transparent) 30%,
        transparent 56%
      ),
      radial-gradient(
        70% 65% at 50% 50%,
        color-mix(in srgb, var(--color-bg-page) 18%, transparent) 0%,
        color-mix(in srgb, var(--color-bg-page) 45%, transparent) 55%,
        color-mix(in srgb, var(--color-bg-page) 68%, transparent) 100%
      );
  }
  html.light .pw-overlay {
    background:
      linear-gradient(
        115deg,
        color-mix(in srgb, var(--color-bg-page) 72%, transparent) 0%,
        color-mix(in srgb, var(--color-bg-page) 45%, transparent) 30%,
        transparent 56%
      ),
      radial-gradient(
        70% 65% at 50% 50%,
        color-mix(in srgb, var(--color-bg-page) 32%, transparent) 0%,
        color-mix(in srgb, var(--color-bg-page) 58%, transparent) 55%,
        color-mix(in srgb, var(--color-bg-page) 78%, transparent) 100%
      );
  }

  @keyframes pw-drift {
    from { translate: 0 -1.5%; }
    to { translate: 0 1.5%; }
  }
  .pw-drift-0 { animation: pw-drift 22s ease-in-out infinite alternate; }
  .pw-drift-1 { animation: pw-drift 28s ease-in-out infinite alternate-reverse; }
  .pw-drift-2 { animation: pw-drift 34s ease-in-out infinite alternate; }
  @media (prefers-reduced-motion: reduce) {
    .pw-drift-0, .pw-drift-1, .pw-drift-2 { animation: none; }
    .pw-col { transition: none; }
  }
</style>

<script>
  function setupPosterParallax() {
    const viewport = document.getElementById('poster-wall-viewport');
    if (!viewport || viewport.dataset.parallaxBound === 'true') return;
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    const cols = Array.from(viewport.querySelectorAll<HTMLElement>('.pw-col'));
    if (!cols.length) return;
    viewport.dataset.parallaxBound = 'true';

    const MAX_PX = 24;
    let raf = 0;
    window.addEventListener('mousemove', (e) => {
      if (raf) return;
      raf = requestAnimationFrame(() => {
        raf = 0;
        const nx = (e.clientX / window.innerWidth - 0.5) * 2;
        const ny = (e.clientY / window.innerHeight - 0.5) * 2;
        for (const col of cols) {
          const depth = parseFloat(col.dataset.depth || '0.7');
          const tx = nx * MAX_PX * depth;
          const ty = ny * MAX_PX * depth * 0.6;
          col.style.transform = `translate3d(${tx}px, ${ty}px, 0)`;
        }
      });
    });
  }

  setupPosterParallax();
  document.addEventListener('astro:after-swap', setupPosterParallax);
</script>
