---
import Base from "../layouts/Base.astro";
import HistoryCard from "../components/HistoryCard.astro";
import Pagination from "../components/Pagination.astro";
import { api, type WatchEvent } from "../lib/api";

const { token } = Astro.locals;
Astro.response.headers.set("Cache-Control", "no-store");
const page = Number(Astro.url.searchParams.get("page") || 1);
const type = Astro.url.searchParams.get("type") || undefined;
const q = Astro.url.searchParams.get("q") || "";
const use24h = Astro.cookies.get("time_format_24h")?.value === "true";

const history = await api.history.list({ page, page_size: 40, type, q: q || undefined }, token);

// Grouping logic
const groupedHistory = history.results.reduce<Record<string, WatchEvent[]>>((acc, event) => {
  const dateStr = event.watched_at
    ? new Date(event.watched_at + 'Z').toLocaleDateString('en-US', {
        weekday: 'long',
        month: 'long',
        day: 'numeric',
        year: 'numeric'
      })
    : 'Date unknown';

  if (!acc[dateStr]) {
    acc[dateStr] = [];
  }
  acc[dateStr].push(event);
  return acc;
}, {});

const dates = Object.keys(groupedHistory);

// Builds a /history URL for a given type/q combo, defaulting each to the
// current page's value so a link only needs to say what it's changing.
const historyUrl = (overrides: { type?: string; q?: string } = {}) => {
  const nextType = overrides.type !== undefined ? overrides.type : (type || "");
  const nextQ = overrides.q !== undefined ? overrides.q : q;
  const params = new URLSearchParams();
  if (nextType) params.set("type", nextType);
  if (nextQ) params.set("q", nextQ);
  const qs = params.toString();
  return `/history${qs ? `?${qs}` : ""}`;
};

const baseUrl = historyUrl();
---

<Base title="Watch History">
  <div>
    <h1 class="page-title mb-8">Watch History</h1>

    <div class="flex flex-col md:flex-row md:items-center gap-3 mb-8">
      <div id="history-tabs" class="flex gap-3">
        <a
          href={historyUrl({ type: "" })}
          class={`px-4 py-1.5 rounded-full text-sm font-medium transition active:scale-95 active:opacity-70 ${!type ? 'bg-zinc-100 text-zinc-900' : 'bg-zinc-800 text-zinc-400 hover:text-zinc-100'}`}
        >
          All
        </a>
        <a
          href={historyUrl({ type: "movie" })}
          class={`px-4 py-1.5 rounded-full text-sm font-medium transition active:scale-95 active:opacity-70 ${type === 'movie' ? 'bg-zinc-100 text-zinc-900' : 'bg-zinc-800 text-zinc-400 hover:text-zinc-100'}`}
        >
          Movies
        </a>
        <a
          href={historyUrl({ type: "episode" })}
          class={`px-4 py-1.5 rounded-full text-sm font-medium transition active:scale-95 active:opacity-70 ${type === 'episode' ? 'bg-zinc-100 text-zinc-900' : 'bg-zinc-800 text-zinc-400 hover:text-zinc-100'}`}
        >
          Shows
        </a>
      </div>

      <form action="/history" method="GET" class="relative md:ml-auto md:w-72">
        {type && <input type="hidden" name="type" value={type} />}
        <svg id="history-search-icon" xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 absolute left-3 top-1/2 -translate-y-1/2 text-zinc-500 pointer-events-none" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-5.197-5.197m0 0A7.5 7.5 0 105.196 5.196a7.5 7.5 0 0010.607 10.607z" />
        </svg>
        <svg id="history-search-spinner" class="hidden absolute left-3 top-1/2 -translate-y-1/2 w-4 h-4 animate-spin text-zinc-500 pointer-events-none" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
          <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
          <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
        </svg>
        <input
          id="history-search-input"
          type="search"
          name="q"
          value={q}
          placeholder="Search your history..."
          class="w-full bg-zinc-900 border border-zinc-800 text-zinc-100 text-sm rounded-full pl-9 pr-4 py-1.5 focus:outline-none focus:border-blue-500 placeholder:text-zinc-500"
        />
      </form>
    </div>

    <div id="history-results">
    {dates.length === 0 ? (
      <div class="bg-zinc-900/50 rounded-2xl p-12 text-center">
        <div class="text-zinc-500 mb-2">{q ? `No results for "${q}"` : "No history yet"}</div>
        <a href={q ? historyUrl({ q: "" }) : "/"} class="text-blue-500 hover:text-blue-400 font-medium transition-colors">
          {q ? "Clear search" : "Go discover something"}
        </a>
      </div>
    ) : (
      <div class="space-y-10">
        {dates.map((date) => (
          <div class="relative">
            <h2 class="group-label mb-4 sticky-top-safe py-2 z-10 border-b border-zinc-800/50">
              {date}
            </h2>
            <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-3">
              {groupedHistory[date].map((event) => (
                <HistoryCard event={event} use24h={use24h} />
              ))}
            </div>
          </div>
        ))}
      </div>
    )}

    <Pagination currentPage={page} totalPages={history.total_pages} baseUrl={baseUrl} />
    </div>
  </div>
</Base>

<script>
  // Live search: debounced re-fetch in place instead of a full-page submit,
  // keeping whatever type tab is already selected. Only #history-tabs and
  // #history-results get swapped - the search input itself (and its form)
  // must never be replaced mid-typing, or it loses focus on every keystroke.
  function setup() {
    const input = document.getElementById('history-search-input') as HTMLInputElement | null;
    let tabsEl = document.getElementById('history-tabs');
    let resultsEl = document.getElementById('history-results');
    if (!input || !tabsEl || !resultsEl) return;

    const icon = document.getElementById('history-search-icon');
    const spinner = document.getElementById('history-search-spinner');
    function setLoading(loading: boolean) {
      icon?.classList.toggle('hidden', loading);
      spinner?.classList.toggle('hidden', !loading);
    }

    let debounceTimer: ReturnType<typeof setTimeout> | undefined;
    let controller: AbortController | undefined;

    async function runSearch(newQ: string) {
      const params = new URLSearchParams(window.location.search);
      if (newQ) params.set('q', newQ); else params.delete('q');
      params.delete('page'); // a new query starts back at page 1
      const url = `/history${params.toString() ? `?${params}` : ''}`;

      controller?.abort();
      controller = new AbortController();
      setLoading(true);
      let res: Response;
      try {
        res = await fetch(url, { signal: controller.signal });
      } catch (e) {
        // Aborted means a newer request already took over and is showing
        // its own spinner - only a real failure should turn it off here.
        if ((e as Error).name !== 'AbortError') { console.error('Live search failed:', e); setLoading(false); }
        return;
      }
      if (!res.ok || !tabsEl || !resultsEl) { setLoading(false); return; }

      const doc = new DOMParser().parseFromString(await res.text(), 'text/html');
      const freshTabs = doc.getElementById('history-tabs');
      const freshResults = doc.getElementById('history-results');
      if (!freshTabs || !freshResults) { setLoading(false); return; }

      tabsEl.replaceWith(freshTabs);
      tabsEl = freshTabs;
      resultsEl.replaceWith(freshResults);
      resultsEl = freshResults;
      // Parsed via DOMParser, so any <script> inside (e.g. Pagination's
      // page-jump form) never actually ran - recreate each so it does.
      resultsEl.querySelectorAll('script').forEach((old) => {
        const fresh = document.createElement('script');
        fresh.textContent = old.textContent;
        old.replaceWith(fresh);
      });

      // replaceState, not push - a history entry per keystroke would make
      // "back" useless.
      window.history.replaceState(null, '', url);
      setLoading(false);
    }

    input.addEventListener('input', () => {
      const val = input.value;
      clearTimeout(debounceTimer);
      debounceTimer = setTimeout(() => runSearch(val), 350);
    });
    // Enter searches immediately instead of waiting out the debounce, and
    // without falling through to a real submit.
    input.closest('form')?.addEventListener('submit', (e) => {
      e.preventDefault();
      clearTimeout(debounceTimer);
      runSearch(input.value);
    });
  }

  setup();
</script>
